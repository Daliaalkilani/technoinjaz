  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev",
    "build": "node --max-old-space-size=4096 scripts/optimize-images.mjs && node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "preview": "npm run build && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-site.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "gl-matrix": "^3.4.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.13",
    "next": "^15.5.26",
    "ogl": "^1.0.11",
    "page-flip": "^2.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.6",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "linkedom": "^0.18.13",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^25.10.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "wrangler": "^4.142.0"
  },
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 115",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "samsung >= 21",
    "not dead"
  ]
