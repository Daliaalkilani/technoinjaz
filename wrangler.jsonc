{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "technoenjaz",
  "main": "./cron-entry.mjs",
  "triggers": { "crons": ["*/15 * * * *"] },
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Every deploy rebuilds from the current source: `wrangler deploy` (or `npm run deploy`)
  // runs the full Next + OpenNext build and copies the prerendered pages into the
  // uploaded assets (populateCache). Deploying a stale .open-next folder shipped old
  // pages, and skipping populateCache made every /articles, /projects, /team page 404.
  "build": { "command": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare populateCache local" },
  "send_email": [
    { "name": "SEND_EMAIL" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "technoenjaz-db", "database_id": "673520c9-5763-47da-a3c7-1bb9cf89e048" }
  ],
  "workers_dev": false
}
